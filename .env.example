# ============================================================
# MineraAI — configuração de integrações
# Cada fonte tem a SUA credencial: nada é compartilhado.
# Sem nenhuma chave a plataforma roda em modo demonstração.
# Copie para .env e preencha o que tiver.
# ============================================================

# ---------------------------------------------------------- 1. PLATAFORMAS OFICIAIS
# YouTube Data API v3 — gratuita, 10.000 unidades/dia
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# TikTok Research API — gratuita, exige aprovação acadêmica/institucional
# https://developers.tiktok.com/products/research-api/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API — gratuita, conta Business/Creator + revisão de app
IG_ACCESS_TOKEN=
IG_USER_ID=

# ---------------------------------------------------------- 2. DADOS PAGOS — VIRLO API
# Orbit (busca), Comet (monitor), Satellite (criador). Leitura gratuita;
# criação custa US$ 0,50 por chamada. Chave começa com virlo_tkn_
# https://dev.virlo.ai/dashboard
VIRLO_API_KEY=
VIRLO_BASE_URL=https://api.virlo.ai/v1
# 1 = usa a Virlo automaticamente como fonte no Radar (fonte paga!)
VIRLO_AUTO_USE=0

# ---------------------------------------------------------- 3. IA (DOIS PROVEDORES SEPARADOS)
# Qual usar: openai | gemini | internal (motor offline grátis)
AI_PROVIDER=internal

# OpenAI (e qualquer endpoint compatível)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------- 4. FONTES GRATUITAS (uma por uma)
# --- Reddit (OAuth client_credentials; sem chave cai no JSON público)
# https://www.reddit.com/prefs/apps → criar app tipo "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MineraAI/2.0 (pesquisa de tendências)
REDDIT_DEFAULT_SUB=Brasil

# --- Mercado Livre (OAuth authorization_code + refresh automático)
# https://developers.mercadolivre.com.br → criar aplicação
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://localhost/cb
MELI_SITE_ID=MLB
# Preenchidos automaticamente pelo fluxo de autorização:
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_TOKEN_EXPIRES_AT=

# --- Google Suggest (NÃO requer chave) + Custom Search opcional
GOOGLE_SUGGEST_HL=pt-BR
GOOGLE_SUGGEST_GL=BR
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- oEmbed (NÃO requer chave)
OEMBED_TIMEOUT=20
OEMBED_PROXY=

# --- Google Trends (NÃO requer chave)
TRENDS_GEO=BR
TRENDS_LANGUAGE=pt-BR

# --- Pexels (chave grátis, própria)
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------------------------------------------------------- 5. PRODUÇÃO — RUNPOD DIRETO
# Sem n8n: o MineraAI chama api.runpod.ai/v2/{endpoint}/runsync direto.
# https://www.runpod.io/console/user/settings (API Keys)
# https://www.runpod.io/console/serverless (Endpoint ID — worker ComfyUI)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TIMEOUT=120
# US$/hora da GPU — usado para estimar custo por job
RUNPOD_GPU_PRICE_HORA=0.44
# Workflow ComfyUI no formato API (export "Save (API Format)").
# Vazio = usa o grafo SDXL txt2img padrão do MineraAI.
RUNPOD_WORKFLOW_TEMPLATE=

# ---------------------------------------------------------- 6. MÍDIA E RETENÇÃO
# Teto por arquivo baixado do RunPod (MB). 0 = não baixa (mantém só a URL do S3).
MEDIA_MAX_MB=200
# Poda automática: janela em dias + intervalo em horas. 0 desliga a poda.
RETENTION_ENABLED=1
RETENTION_DIAS=90
RETENTION_INTERVALO_H=6

# ---------------------------------------------------------- 7. AGENDADORES
# Research Agents (loop asyncio interno)
AGENTS_SCHEDULER=1
AGENTS_INTERVAL=60
# Monitores de nicho (Comet)
MINING_SCHEDULER=1

# ---------------------------------------------------------- 8. SERVIDOR
HOST=0.0.0.0
PORT=8000
