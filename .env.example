# ============================================================
# MineraAI — Configuração de APIs (todas opcionais)
# Sem nenhuma chave, a plataforma roda em MODO DEMONSTRAÇÃO
# com dados simulados realistas para você explorar o produto.
# Copie este arquivo para .env e preencha o que tiver.
# ============================================================

# --- YouTube Data API v3 (OFICIAL · GRATUITA · 10.000 unidades/dia)
# Crie em: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- TikTok Research API (OFICIAL · GRATUITA · requer aprovação acadêmica)
# Solicite em: https://developers.tiktok.com/products/research-api/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram Graph API (OFICIAL · GRATUITA · requer conta Business/Creator)
# Crie em: https://developers.facebook.com → produto Instagram
# IG_ACCESS_TOKEN: token de longa duração da conta profissional
# IG_USER_ID: id numérico da conta Instagram profissional
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- IA (opcional — sem chave usamos o motor interno gratuito)
# Groq (tier gratuito generoso): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (tier gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Qualquer API compatível com OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Servidor
HOST=0.0.0.0
PORT=8000
