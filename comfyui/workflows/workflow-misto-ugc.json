{
  "_comment": "MineraAI — Workflow MISTO UGC: 3 imagens (GANCHO/DEMO/CTA) + video curto — ideal para curadoria",
  "nodes_comment": "Este workflow gera 3 imagens batch + 1 video a partir do mesmo prompt base. n8n injeta prompts por cena.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 768,
      "height": 1344,
      "batch_size": 3
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_CENA_1_GANCHO — close-up rosto surpreso, garrafa térmica ao fundo desfocada, luz natural, UGC style, 9:16",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_CENA_2_DEMO — garrafa térmica com gelo, mão segurando, cozinha real, demonstração uso, UGC, vertical",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_CENA_3_CTA — garrafa térmica na mesa com texto overlay 'LINK NA BIO', produto em destaque, CTA visual",
      "clip": ["1", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "low quality, blurry, watermark, logo, text, deformed, extra limbs, cartoon",
      "clip": ["1", 1]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1001,
      "steps": 28,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["3", 0],
      "negative": ["6", 0],
      "latent_image": ["2", 0]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1002,
      "steps": 28,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["6", 0],
      "latent_image": ["2", 0]
    }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1003,
      "steps": 28,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["2", 0]
    }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "21": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["1", 2]
    }
  },
  "22": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["1", 2]
    }
  },
  "30": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "mineraai/misto_gancho",
      "images": ["20", 0]
    }
  },
  "31": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "mineraai/misto_demo",
      "images": ["21", 0]
    }
  },
  "32": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "mineraai/misto_cta",
      "images": ["22", 0]
    }
  },
  "40": {
    "class_type": "ADE_LoadAnimateDiffModel",
    "inputs": {
      "model_name": "mm_sd_v15_v2.ckpt"
    }
  },
  "41": {
    "class_type": "ADE_AnimateDiffLoaderWithContext",
    "inputs": {
      "model": ["1", 0],
      "motion_model": ["40", 0],
      "beta_schedule": "sqrt_linear (AnimateDiff)",
      "context_length": 16,
      "context_stride": 1,
      "context_overlap": 4
    }
  },
  "42": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 768,
      "batch_size": 16
    }
  },
  "43": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_VIDEO_GERAL — video curto UGC garrafa térmica, mão usando produto, movimento suave, 9:16 vertical, 6s",
      "clip": ["1", 1]
    }
  },
  "44": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 2001,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["41", 0],
      "positive": ["43", 0],
      "negative": ["6", 0],
      "latent_image": ["42", 0]
    }
  },
  "45": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["44", 0],
      "vae": ["1", 2]
    }
  },
  "46": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["45", 0],
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "mineraai/misto_video",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19
    }
  }
}
