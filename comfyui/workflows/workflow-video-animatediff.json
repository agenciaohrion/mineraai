{
  "_comment": "MineraAI — AnimateDiff Text-to-Video 16 frames vertical — API Format RunPod",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "realisticVisionV60B1_v51HyperVAE.safetensors"
    }
  },
  "2": {
    "class_type": "ADE_LoadAnimateDiffModel",
    "inputs": {
      "model_name": "mm_sd_v15_v2.ckpt"
    }
  },
  "3": {
    "class_type": "ADE_AnimateDiffLoaderWithContext",
    "inputs": {
      "model": ["1", 0],
      "motion_model": ["2", 0],
      "beta_schedule": "sqrt_linear (AnimateDiff)",
      "context_length": 16,
      "context_stride": 1,
      "context_overlap": 4,
      "context_schedule": "uniform",
      "closed_loop": false
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 768,
      "batch_size": 16
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PROMPT_VIDEO — garrafa térmica com gelo caindo em slow motion, mesa de madeira, luz natural, cinematic, 9:16 vertical, alta qualidade, movimento suave",
      "clip": ["1", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "low quality, blurry, text, watermark, logo, deformed, extra fingers, static, no movement",
      "clip": ["1", 1]
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["4", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    }
  },
  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["9", 0],
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "mineraai/video",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false
    }
  }
}
